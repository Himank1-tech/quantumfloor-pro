# ==============================================================================
# AUTONOMOUS TRADING FLOOR - CONFIGURATION ENVIRONMENT
# Institutional Multi-Agent Trading Floor (Indian Equities + Global Forex)
# ==============================================================================

# ==================== INDIAN BROKER INTEGRATION (NSE / BSE) ====================
# Zerodha Kite Connect API
KITE_API_KEY=your_zerodha_api_key
KITE_API_SECRET=your_zerodha_api_secret
KITE_ACCESS_TOKEN=your_zerodha_access_token

# Dhan HQ API
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token

# Angel One SmartAPI
SMARTAPI_API_KEY=your_angel_api_key
SMARTAPI_CLIENT_CODE=your_client_code
SMARTAPI_PASSWORD=your_password
SMARTAPI_TOTP_KEY=your_totp_secret

# ==================== GLOBAL FOREX BROKER INTEGRATION ====================
# OANDA v20 REST API
OANDA_API_KEY=your_oanda_v20_token
OANDA_ACCOUNT_ID=your_oanda_account_id
OANDA_ENVIRONMENT=practice  # practice or live

# MetaTrader 5 (MT5) Gateway
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=MetaQuotes-Demo

# ==================== MULTI-AGENT & LLM REASONING ====================
# Google Gemini API (for advanced LLM agent debate synthesis)
GEMINI_API_KEY=your_gemini_api_key_here

# ==================== QUANTITATIVE RISK GOVERNOR THRESHOLDS ====================
MAX_ASSET_CONCENTRATION_PCT=15.0   # Maximum 15% portfolio NAV in any single asset
SOFT_DAILY_DRAWDOWN_LIMIT_PCT=3.0  # -3% daily loss reduces position sizing by 50%
HARD_DAILY_DRAWDOWN_LIMIT_PCT=5.0  # -5% daily loss halts all opening executions
MAX_TOTAL_DRAWDOWN_LIMIT_PCT=10.0  # -10% cumulative drawdown activates kill switch
VOLATILITY_BRAKE_MULTIPLIER=2.5    # 2.5x volatility spike triggers size trim
KELLY_FRACTION=0.5                 # Half-Kelly sizing factor (0.5)

# ==================== SYSTEM RUNTIME ====================
HOST=0.0.0.0
PORT=8001
SIMULATION_MODE=true               # Set to false for live broker order routing
DEFAULT_INR_CAPITAL=1000000.0      # ₹10,00,000 INR
DEFAULT_USD_CAPITAL=25000.0        # $25,000 USD
